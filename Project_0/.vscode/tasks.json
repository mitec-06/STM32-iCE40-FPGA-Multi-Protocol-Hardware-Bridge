{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Flash STM32",
            "type": "shell",
            "command": "STM32_Programmer_CLI.exe",
            "args": [
                "-c", "port=SWD",
                "-w", "${workspaceFolder}/build/Debug/led_turnon.elf",
                "-v",
                "-rst"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": [
                "CMake: build"
            ],
            "problemMatcher": []
        }
    ]
}